# Dependencies
node_modules/

# Output of the retired runners and the VoiceOver spike. Nothing writes here
# now; the directories are kept ignored because local copies still hold
# evidence from past investigations.
runs/
voiceover-runs/

# Rig output: the daemon's and the smoke's logs, results and pid file, and the
# Provisioner's report.
artifacts/
packages/guest/provisioning/health-report.json

# Written by `npm run voiceover:doctor`, and specific to this Mac.
packages/guest/voiceover/doctor.json

# The guest daemon's URL and token, for driving the rig from the host.
.env.rig
