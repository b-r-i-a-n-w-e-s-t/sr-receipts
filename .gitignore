# Dependencies
node_modules/

# Hermetic Firefox profile. Regenerated by ensureProfile() on every run.
# ~300 MB / 1600 files, and it accumulates cookies, cache and browsing history
# from every page the rig has ever loaded.
ff-profile/

# Run output. Transcripts are stamped with the exact NVDA/Firefox/Windows build
# that produced them, so they are evidence, not source. Promote the ones worth
# keeping into baselines/ deliberately.
runs/
last-run.txt

# Probe scratch. probe.json and probe-fixture.txt are hand-edited inputs that
# change every few minutes while working out a key sequence; commit the
# .example files instead.
probe.json
probe-fixture.txt
probe-out.txt
probe-done.txt
probe.out

# Queue scratch, same reasoning.
queue.txt

# Console logs from the .cmd wrappers.
run.out
runner.out
artifacts/
packages/guest/provisioning/health-report.json

# Full-desktop screenshot written by shot.ps1. Captures whatever else was on the
# guest desktop at the time, including editor windows and terminals.
screen.png

# Throwaway tsc projects written by test/types.test.ts.
.type-case-*/

# Console log from run-daemon.cmd.
daemon.out
voiceover-runs/
packages/guest/voiceover/doctor.json

# The guest daemon's URL and token, for driving the rig from the host.
.env.rig
