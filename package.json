{
  "name": "nvda-rig",
  "private": true,
  "description": "Workspace root for the sr-receipts packages. Not itself a package.",
  "type": "module",
  "workspaces": [
    "packages/host",
    "packages/voiceover",
    "packages/playwright",
    "packages/daemon"
  ],
  "scripts": {
    "build": "tsc -b packages/host packages/voiceover packages/playwright packages/daemon",
    "test": "npm run build && npm test --workspaces && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "typescript": "^7.0.2",
    "@playwright/test": "^1.63.0"
  }
}
