  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@sr-receipts/host": "0.2.1"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0",
    "@sr-receipts/voiceover": "0.2.1"
  },
  "peerDependenciesMeta": {
    "@sr-receipts/voiceover": {
      "optional": true
    }
  }
}
