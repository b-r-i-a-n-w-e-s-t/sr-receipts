{
  "name": "@sr-receipts/playwright",
  "version": "0.2.1",
  "description": "A reader fixture for Playwright Test: drive a real screen reader beside page from a consuming repo's own tests.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
