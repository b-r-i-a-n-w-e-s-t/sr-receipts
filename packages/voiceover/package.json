{
  "name": "@sr-receipts/voiceover",
  "version": "0.2.0",
  "description": "VoiceOver as a reader session, in process on a Mac, for the sr-receipts Playwright fixture; and a read-only doctor for its prerequisites.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sr-voiceover-doctor": "./dist/bin/doctor.js"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "doctor": "node src/bin/doctor.ts"
  },
  "dependencies": {
    "@guidepup/guidepup": "0.34.0",
    "@sr-receipts/host": "0.2.0"
  }
}
