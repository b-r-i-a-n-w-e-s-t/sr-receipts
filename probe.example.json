{
  "name": "probe",
  "description": "Scratch. Working out a key sequence before it earns a file in scenarios/.",
  "modeProbes": ["moveToNextTable"],
  "steps": [
    { "label": "title bar", "perform": "reportTitle" },
    { "label": "focus and mode", "perform": "reportCurrentFocus" },
    { "label": "next table", "perform": "moveToNextTable" },
    { "label": "enter the table", "press": "ArrowDown" },
    { "label": "first data row", "perform": "moveToNextRow" },
    { "label": "ctrl+alt+right, move", "perform": "moveToNextColumn", "repeat": 6 }
  ]
}
