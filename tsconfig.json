{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // The rig runs .ts directly: Node 24 strips types with no build step, so
    // `node runner.ts` works from the scheduled task exactly as `node
    // runner.cjs` did. Nothing is emitted here — tsc only checks. That split is
    // the point: the guest needs no toolchain, and the types still mean
    // something because `npm test` runs `tsc --noEmit`.
    "noEmit": true,

    // Type stripping erases annotations rather than compiling them, so the
    // source must contain nothing that needs compiling. These two keep it that
    // way: no enums, no parameter properties, no namespaces, and every
    // type-only import written as `import type`.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // Node resolves the real file, so imports carry the real extension.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["lib/**/*.ts", "scenarios/**/*.ts", "test/**/*.ts", "*.ts"]
}
