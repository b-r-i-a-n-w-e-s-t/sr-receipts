{
  // The typecheck of everything, tests included; `npm test` runs it. Nothing
  // is emitted from here: each package's own tsconfig.json builds its dist/.
  // A package reaches its siblings through their dist/ declarations, so this
  // needs `npm run build` first, as `npm test` does.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "scripts/**/*.ts"]
}
